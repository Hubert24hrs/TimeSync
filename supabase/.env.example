# Edge Function secrets: `supabase secrets set --env-file supabase/.env`. Never commit supabase/.env.
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected automatically.

# >= 32 random chars. Signs emailed reschedule/cancel links.
LINK_SIGNING_SECRET=
# Public web origin for links in emails.
PUBLIC_ORIGIN=https://timesync.app
# Shared secret the scheduler (pg_cron) sends to send-reminders.
CRON_SECRET=

# Optional paid services: features degrade gracefully when unset.
# AI assistant (Claude). Without it, the assistant answers from the built-in optimizer.
ANTHROPIC_API_KEY=
# Transactional email (Resend). Without it, emails are logged instead of sent.
RESEND_API_KEY=
EMAIL_FROM=TimeSync <bookings@timesync.app>

# Calendar sync OAuth apps (free to create in Google Cloud / Azure).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Slack app signing secret for the /timesync slash command.
SLACK_SIGNING_SECRET=
