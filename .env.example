# Copy to .env (never commit .env). Only EXPO_PUBLIC_* values are bundled into the app,
# so they must be safe to expose: the Supabase anon key is protected by Row Level Security.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Public origin used for booking links, QR codes and the embed widget.
EXPO_PUBLIC_BOOKING_ORIGIN=https://timesync.app

# ---- Server-side only: set these as Supabase Edge Function secrets, NOT in the app ----
#   supabase secrets set --env-file supabase/.env
# See supabase/.env.example.
